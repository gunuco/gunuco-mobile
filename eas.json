{
  "cli": {
    "version": ">= 16.17.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ENABLE_LOGGING": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.dev.gunuco.local",
        "EXPO_PUBLIC_UI_TEST_MODE": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_ENABLE_LOGGING": "true",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.staging.gunuco.com",
        "EXPO_PUBLIC_UI_TEST_MODE": "false"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ENABLE_LOGGING": "false",
        "EXPO_PUBLIC_API_BASE_URL": "https://api.gunuco.com",
        "EXPO_PUBLIC_UI_TEST_MODE": "false"
      }
    },
    "native-test": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_ENABLE_LOGGING": "true",
        "EXPO_PUBLIC_UI_TEST_MODE": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
